# DOMÍNIO — PROVISÓRIO (NÃO CONFIRMADO pela cliente).
# Enquanto VITE_SITE_CONFIRMED=false, o build NÃO publica canonical, og:url, URLs absolutas
# no JSON-LD nem sitemap.xml. Ao confirmar o domínio: ajuste a URL (sem barra final) e mude para true.
VITE_SITE_URL=https://www.heloisagavazzi.com.br
VITE_SITE_CONFIRMED=false
